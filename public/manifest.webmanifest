{
  "name": "Devotly — Daily Devotionals & Prayer",
  "short_name": "Devotly",
  "description": "Daily devotionals, sermons, prayer timer, fasting tracker and family devotionals — built for everyday faith.",
  "categories": ["lifestyle", "religion", "education"],
  "shortcuts": [
    { "name": "New Devotional", "url": "/generate", "description": "Create a new devotional" },
    { "name": "Prayer Timer", "url": "/prayer-timer", "description": "Start a prayer session" },
    { "name": "Reading Plan", "url": "/reading-plan", "description": "Today's Bible reading" }
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#faf6f0",
  "theme_color": "#5b2a4a",
  "orientation": "portrait",
  "handle_links": "preferred",
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "shared" }
  },
  "icons": [
    { "src": "/icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any maskable" },
    { "src": "/icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any maskable" }
  ]
}
